# RepoLens environment configuration
# Copy this file to `.env` and fill in your values.
# The local JSON cache fallback keeps working even when these are missing.

# --- Supabase (optional but recommended) ---
# Get these from: https://supabase.com/dashboard/project/_/settings/api
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_KEY=your-anon-or-service-role-key

# Aliases also accepted (last one set wins):
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# --- Optional overrides ---
# REPOLENS_CACHE_TABLE=repo_analysis
# REPOLENS_CACHE_FILE=.repolens_cache.json

# --- Security (recommended if this service is reachable by anyone but you) ---
# /api/analyze can read any local filesystem path. Set an API key to require
# `Authorization: Bearer <key>` on requests. Leave unset for local-only use.
# REPOLENS_API_KEY=

# Comma-separated list of origins allowed to call this API via CORS.
# Defaults to http://localhost:8000,http://127.0.0.1:8000 if unset.
# REPOLENS_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
